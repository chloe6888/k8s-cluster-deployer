# {{ ansible_managed }} —— 手册 3.4；advert_int 内外网均 1（修订点 13）；label 超 15 字符自动省略。
global_defs {
    router_id {{ node_name }}
    script_user root
    enable_script_security
}

vrrp_script checkhaproxy
{
    script "/etc/keepalived/check-haproxy.sh"
    interval 2
    timeout 5
    weight -30
    fall 1
    rise 1
}

vrrp_instance VI_INTERNAL {
    state {{ ka_state }}
    interface {{ node_iface }}
    virtual_router_id {{ ka_vrid }}
    priority {{ ka_priority }}
    advert_int {{ ka_advert_int }}

    virtual_ipaddress {
        {{ vip }}/{{ vip_prefix }} dev {{ node_iface }}{% if (node_iface ~ ':' ~ ka_vrid) | length <= 15 %} label {{ node_iface }}:{{ ka_vrid }}{% endif %}
    }

    authentication {
        auth_type PASS
        auth_pass {{ ka_auth_pass }}
    }

    track_script {
        checkhaproxy
    }
}

vrrp_instance VI_EXTERNAL {
    state {{ ka_state }}
    interface {{ ext_iface }}
    virtual_router_id {{ ka_ext_vrid }}
    priority {{ ka_priority }}
    advert_int {{ ka_ext_advert_int }}

    virtual_ipaddress {
        {{ ext_vip }}/{{ ext_vip_prefix }} dev {{ ext_iface }}{% if (ext_iface ~ ':' ~ ka_ext_vrid) | length <= 15 %} label {{ ext_iface }}:{{ ka_ext_vrid }}{% endif %}
    }

    authentication {
        auth_type PASS
        auth_pass {{ ka_auth_pass }}
    }

    track_script {
        checkhaproxy
    }
}
