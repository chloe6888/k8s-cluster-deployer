# 手册 8.4③：接管 http 监听器上所有未被其他路由匹配的请求；业务需保留 80 明文时勿启用。
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: http-to-https
  namespace: envoy-gateway-system
spec:
  parentRefs:
  - name: gw-ext
    sectionName: http
  rules:
  - filters:
    - type: RequestRedirect
      requestRedirect:
        scheme: https
        statusCode: 301
