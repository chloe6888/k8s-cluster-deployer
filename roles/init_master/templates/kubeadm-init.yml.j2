# kubeadm v1beta4
# 由 Ansible 渲染，勿手改；重跑本 role 幂等（init 由 kube-system/kubeadm-config 存在性把关）。
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ node_ip }}          # apiserver 只通告内网 IP
  bindPort: 6443
nodeRegistration:
  name: {{ node_name }}
  criSocket: unix:///run/containerd/containerd.sock   # 显式声明，不靠探测
  imagePullPolicy: IfNotPresent
  taints: []                               # master 可调度业务，显式清空
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: v{{ kubernetes_version }}
clusterName: {{ cluster_prefix }}-k8s-prod
certificatesDir: /etc/kubernetes/pki
imageRepository: {{ registry }}/google_containers   # 离线必备：images pull 与静态 Pod 镜像引用都取自此
controlPlaneEndpoint: {{ vip }}:{{ vip_port }}      # HAProxy 前置 VIP
apiServer:
  # 决策 #48：SAN 只收实际访问路径——内网 VIP、各 master 直连 IP+主机名（HA 层
  # 故障时的救火通道）、extra_cert_sans（外网 NGINX 入口）、localhost。
  # ext_vip 不进 SAN：外网访问走 NGINX 入口（在 extra_cert_sans），
  # 无客户端以 ext_vip 地址直连 apiserver（HAProxy 虽仍 bind 该地址）
  certSANs:
  - {{ vip }}
{% for h in groups['masters'] %}
  - {{ hostvars[h]['node_ip'] }}
  - {{ h }}
{% endfor %}
{% for san in extra_cert_sans | default([]) %}
  - {{ san }}
{% endfor %}
  - localhost
  - 127.0.0.1
certificateValidityPeriod: 175200h         # 叶子证书 20 年（默认 8760h）
caCertificateValidityPeriod: 175200h       # CA 20 年（默认 87600h）
networking:
  dnsDomain: cluster.local
  podSubnet: {{ pod_cidr }}
  serviceSubnet: {{ service_cidr }}
etcd:
  local:
    dataDir: /var/lib/etcd
    extraArgs:
    - name: quota-backend-bytes
      value: "{{ etcd_quota_bytes }}"
---
apiVersion: kubeproxy.config.k8s.io/v1alpha1
kind: KubeProxyConfiguration
mode: nftables
nodePortAddresses:
- {{ node_cidr }}                          # NodePort 只在内网监听
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
maxPods: 110
kubeReserved:    { cpu: "4", memory: 4Gi }
systemReserved:  { cpu: "2", memory: 2Gi }
enforceNodeAllocatable: [pods]
evictionHard:
  memory.available: "5%"
  nodefs.available: "10%"
  nodefs.inodesFree: "5%"
  imagefs.available: "10%"
evictionSoft:
  memory.available: "10%"
  nodefs.available: "15%"
  nodefs.inodesFree: "10%"
  imagefs.available: "15%"
evictionSoftGracePeriod:
  memory.available: 2m
  nodefs.available: 2m
  nodefs.inodesFree: 2m
  imagefs.available: 2m
evictionMaxPodGracePeriod: 30
evictionMinimumReclaim:
  memory.available: 0Mi
  nodefs.available: 500Mi
  imagefs.available: 500Mi
containerLogMaxSize: 50Mi
containerLogMaxFiles: 5